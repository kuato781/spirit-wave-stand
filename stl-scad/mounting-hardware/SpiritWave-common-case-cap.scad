// Spirit WAVE SMUT™ — Mule 0.16 common case-cap source reference
//
// The 0.16 common cap is carried forward unchanged from the proven 0.11 cap.
// The printable STL in the package is the authoritative frozen geometry.

fit_d = 4.90;              // Spirit WAVE round-handle channel
m3_clearance_d = 3.40;     // free-pass M3 cap screw hole
cap_bottom_trim = 1.00;    // 0.11: shortened 1 mm from bottom

// Round handle architecture:
// cap receives the TOP 180° of the 4.90 mm channel;
// case body receives the BOTTOM 180° cradle.
// Left/right use the same common cap because the WAVE rails are parallel.

// Insert/collar geometry belongs to the case body, not this cap.
